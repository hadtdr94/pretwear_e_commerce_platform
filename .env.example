# --- General ---
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

# --- Frontend (Vite) ---
VITE_API_URL=/api

# --- Backend ---
PORT=4000
CLIENT_URL=http://localhost
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- Database (PostgreSQL) ---
POSTGRES_USER=pretwear
POSTGRES_PASSWORD=pretwear_password
POSTGRES_DB=pretwear
# Host port mapped to the postgres container (container still listens on 5432 internally)
POSTGRES_PORT=5433
DATABASE_URL=postgresql://pretwear:pretwear_password@postgres:5432/pretwear?schema=public

# --- Uploads / Cloudinary-ready ---
UPLOAD_DIR=src/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (optional, for forgot/reset password) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Maps (optional) ---
VITE_GOOGLE_MAPS_API_KEY=
