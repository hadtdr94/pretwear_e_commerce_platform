generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  MANAGER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  COD
  OTHER
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

enum CustomizationStatus {
  PENDING
  REVIEWING
  QUOTED
  APPROVED
  IN_PRODUCTION
  COMPLETED
  REJECTED
  CANCELLED
}

model User {
  id                   String                 @id @default(cuid())
  email                String                 @unique
  password             String
  firstName            String?
  lastName             String?
  phone                String?
  role                 Role                   @default(CUSTOMER)
  isActive             Boolean                @default(true)
  resetTokenHash       String?
  resetTokenExpiresAt  DateTime?
  addresses            Address[]
  carts                Cart[]
  orders               Order[]
  customizationRequests CustomizationRequest[]
  reviews              Review[]
  favorites            Favorite[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([role])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String
  wilaya    String
  commune   String
  address   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive])
}

model Size {
  id        String           @id @default(cuid())
  name      String           @unique
  sortOrder Int              @default(0)
  variants  ProductVariant[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model Color {
  id        String           @id @default(cuid())
  name      String           @unique
  hex       String?
  variants  ProductVariant[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model Product {
  id           String           @id @default(cuid())
  name         String
  slug         String           @unique
  description  String
  basePrice    Int              // DZD
  salePrice    Int?             // DZD
  categoryId   String
  category     Category         @relation(fields: [categoryId], references: [id])
  isActive     Boolean          @default(true)
  isFeatured   Boolean          @default(false)
  isCustomizable Boolean        @default(false)
  images       ProductImage[]
  variants     ProductVariant[]
  reviews      Review[]
  favorites    Favorite[]
  orderItems   OrderItem[]
  cartItems    CartItem[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([categoryId])
  @@index([isActive, isFeatured])
  @@index([createdAt])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizeId     String?
  size       Size?       @relation(fields: [sizeId], references: [id])
  colorId    String?
  color      Color?      @relation(fields: [colorId], references: [id])
  sku        String      @unique
  price      Int?        // override DZD
  salePrice  Int?
  isActive   Boolean     @default(true)
  inventory  Inventory?
  cartItems  CartItem[]
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([productId, sizeId, colorId])
  @@index([productId])
}

model Inventory {
  id        String         @id @default(cuid())
  variantId String         @unique
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(0)
  reserved  Int            @default(0)
  lowStock  Int            @default(5)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String?    @unique
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id])
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int            @default(1)
  unitPrice Int            // snapshot DZD
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([productId])
}

model Order {
  id             String      @id @default(cuid())
  reference      String      @unique
  userId         String?
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  status         OrderStatus @default(PENDING)
  customerName   String
  customerPhone  String
  customerEmail  String?
  wilaya         String
  commune        String
  address        String
  notes          String?
  subtotal       Int
  deliveryFee    Int         @default(0)
  discount       Int         @default(0)
  total          Int
  items          OrderItem[]
  payment        Payment?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId])
  @@index([status, createdAt])
}

model OrderItem {
  id          String         @id @default(cuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product        @relation(fields: [productId], references: [id])
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  productName String
  variantName String?
  sku         String?
  unitPrice   Int
  quantity    Int
  lineTotal   Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([orderId])
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String        @unique
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method    PaymentMethod @default(COD)
  status    PaymentStatus @default(PENDING)
  amount    Int
  provider  String?
  reference String?
  metadata  Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model CustomizationRequest {
  id            String                   @id @default(cuid())
  userId        String?
  user          User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName  String
  phone         String
  email         String?
  customerType  CustomerType
  productType   String
  quantity      Int
  sizes         String?
  colors        String?
  technique     String
  description   String
  wilaya        String
  status        CustomizationStatus      @default(PENDING)
  adminNotes    String?
  attachments   CustomizationAttachment[]
  quotes        Quote[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

model CustomizationAttachment {
  id           String               @id @default(cuid())
  requestId    String
  request      CustomizationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([requestId])
}

model Quote {
  id        String               @id @default(cuid())
  requestId String
  request   CustomizationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  amount    Int
  currency  String               @default("DZD")
  note      String?
  validUntil DateTime?
  createdBy String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([requestId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  isApproved Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  type        String   @default("PERCENT") // PERCENT or FIXED
  value       Int
  minOrder    Int?
  maxUses     Int?
  usedCount   Int      @default(0)
  isActive    Boolean  @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DeliveryZone {
  id        String   @id @default(cuid())
  wilaya    String
  commune   String?
  fee       Int
  isActive  Boolean  @default(true)
  etaMinDays Int?
  etaMaxDays Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([wilaya, commune])
  @@index([wilaya])
}

model StoreSettings {
  id            String   @id @default("default")
  businessName  String   @default("PRETWEAR")
  slogan        String?  @default("Wear it. Brand it. Make it yours.")
  phone         String?
  whatsapp      String?
  email         String?
  address       String?  @default("Bordj El Kiffan, Algiers, Algeria")
  currency      String   @default("DZD")
  socialLinks   Json?
  content       Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
